{
  "name": "envorigin-vscode",
  "displayName": "EnvOrigin",
  "description": "Explain where environment variables come from — hover, go-to-definition, and live diagnostics for Docker Compose, GitHub Actions, GitLab CI, and CircleCI configs.",
  "version": "0.5.1",
  "publisher": "fier",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/compose.yaml",
    "workspaceContains:**/compose.yml",
    "workspaceContains:**/docker-compose.yaml",
    "workspaceContains:**/.github/workflows/*.yml",
    "workspaceContains:**/.gitlab-ci.yml",
    "workspaceContains:**/.circleci/config.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "EnvOrigin",
      "properties": {
        "envorigin.binaryPath": {
          "type": "string",
          "default": "envorigin",
          "description": "Path to the envorigin binary (e.g. ~/.cargo/bin/envorigin)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vscode-languageclient": "^9.0.0"
  }
}
